PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.kifrk7a.mongodb.net/task_management?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters_for_production
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
